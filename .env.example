# Template ONLY. Put real values in a local .env file (never commit .env).
# These are not real credentials.
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ACCOUNT=your_account_locator

# Optional, intended for a separate future sandbox refactor:
SNOWFLAKE_DATABASE=WING_PORTFOLIO_SANDBOX
SNOWFLAKE_SCHEMA=DEMO
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Default to not running destructive DDL or starting scheduled tasks:
ENABLE_TASK_CHANGES=false
ENABLE_DESTRUCTIVE_TRANSFORM=false
